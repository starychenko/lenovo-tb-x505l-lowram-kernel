# Build and release output
/artifacts/
/release-staging/
/outputs/
/out/
/out-*/

# Large release assets belong in GitHub Releases, not Git history
/*.img
/*.zip
/*.tar
/*.tar.gz
/*.xz

# Local device backups and vendor binaries must never be published
/private/
/backups/
*stock-boot*
*factory-boot*
*.ko
*.bin
*.mbn
*.apk
*.pem
*.x509
*.jpg
*.jpeg
*.png
*.webp

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
