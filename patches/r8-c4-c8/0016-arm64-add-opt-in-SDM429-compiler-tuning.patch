From 89a0e1e5f2f6636f0f568d8fad9d6b3575609fdb Mon Sep 17 00:00:00 2001
From: Yevhenii Starychenko <Evgeniistarychenko@gmail.com>
Date: Mon, 31 Aug 2026 20:35:23 +0000
Subject: [PATCH 16/17] arm64: add opt-in SDM429 compiler tuning

Expose compiler-controlled inline decisions on arm64 and add a separately selectable Cortex-A53 code-generation target for SDM429. Both remain opt-in so generic builds and candidate comparisons stay possible.
---
 arch/arm64/Kconfig  | 20 ++++++++++++++++++++
 arch/arm64/Makefile |  4 ++++
 2 files changed, 24 insertions(+)

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index 0304bf212c3..829a04e97a6 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -134,6 +134,26 @@ config ARM64
 	help
 	  ARM 64-bit (AArch64) Linux support.
 
+config ARCH_SUPPORTS_OPTIMIZED_INLINING
+	def_bool y
+
+config OPTIMIZE_INLINING
+	bool "Allow the compiler to choose whether inline functions are inlined"
+	default n
+	help
+	  Let modern compilers decide whether functions marked inline should
+	  actually be inlined. This normally reduces code size and instruction
+	  cache pressure, but should be qualified on the target toolchain.
+
+config ARM64_TUNE_CORTEX_A53
+	bool "Generate kernel code for Cortex-A53"
+	depends on ARCH_SDM429
+	default n
+	help
+	  Tune generated ARM64 kernel code for the Cortex-A53 cores used by
+	  SDM429, including the crypto and CRC extensions exposed by the SoC.
+	  Leave this disabled for generic ARM64 builds.
+
 config 64BIT
 	def_bool y
 
diff --git a/arch/arm64/Makefile b/arch/arm64/Makefile
index 67a50bc8bc0..64bfda2d88a 100644
--- a/arch/arm64/Makefile
+++ b/arch/arm64/Makefile
@@ -52,6 +52,10 @@ endif
 
 KBUILD_CFLAGS	+= -mgeneral-regs-only $(lseinstr)
 
+ifeq ($(CONFIG_ARM64_TUNE_CORTEX_A53), y)
+KBUILD_CFLAGS	+= $(call cc-option,-mcpu=cortex-a53+crypto+crc,-march=armv8-a+crypto+crc)
+endif
+
 ifeq ($(CONFIG_COMPAT_VDSO), y)
   CROSS_COMPILE_ARM32 ?= $(CONFIG_CROSS_COMPILE_ARM32:"%"=%)
 
