diff --git a/kernel/module.c b/kernel/module.c
index ee3c9f14e79..8047241b5c4 100644
--- a/kernel/module.c
+++ b/kernel/module.c
@@ -270,7 +270,13 @@ static void module_assert_mutex_or_preempt(void)
 #endif
 }
 
-static bool sig_enforce = IS_ENABLED(CONFIG_MODULE_SIG_FORCE);
+/*
+ * Lenovo's production modules are signed with a private key that is not part
+ * of the published kernel source.  Keep signature verification and module
+ * version checks, but allow modules whose signing key is not in this build's
+ * keyring.  Invalid signatures are still rejected.
+ */
+static bool sig_enforce;
 #ifndef CONFIG_MODULE_SIG_FORCE
 module_param(sig_enforce, bool_enable_only, 0644);
 #endif /* !CONFIG_MODULE_SIG_FORCE */
@@ -1268,6 +1274,36 @@ static unsigned long maybe_relocated(unsigned long crc,
 	return crc;
 }
 
+/*
+ * Lenovo did not publish the exact source/config used for the loadable
+ * TB-X505L audio and WLAN drivers.  The shipping modules are nevertheless
+ * tied to this device and are the only variants that preserve Lenovo's
+ * hardware-specific changes and early-init ordering.  Permit version CRC
+ * drift only for that closed, explicit module set; all other modules keep
+ * normal CONFIG_MODVERSIONS enforcement.
+ */
+static bool tb_x505l_vendor_module(const struct module *mod)
+{
+	static const char * const names[] = {
+		"adsp_loader_dlkm", "analog_cdc_dlkm", "apr_dlkm",
+		"cpe_lsm_dlkm", "digital_cdc_dlkm", "hdmi_dlkm",
+		"machine_dlkm", "machine_ext_dlkm", "mbhc_dlkm",
+		"native_dlkm", "pinctrl_wcd_dlkm", "platform_dlkm",
+		"q6_dlkm", "q6_notifier_dlkm", "stub_dlkm",
+		"swr_ctrl_dlkm", "swr_dlkm", "usf_dlkm",
+		"wcd9335_dlkm", "wcd9xxx_dlkm", "wcd_core_dlkm",
+		"wcd_cpe_dlkm", "wsa881x_analog_dlkm", "wsa881x_dlkm",
+		"wlan",
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++)
+		if (!strcmp(mod->name, names[i]))
+			return true;
+
+	return false;
+}
+
 static int check_version(Elf_Shdr *sechdrs,
 			 unsigned int versindex,
 			 const char *symname,
@@ -1296,6 +1332,12 @@ static int check_version(Elf_Shdr *sechdrs,
 
 		if (versions[i].crc == maybe_relocated(*crc, crc_owner))
 			return 1;
+		if (tb_x505l_vendor_module(mod)) {
+			add_taint_module(mod, TAINT_FORCED_MODULE,
+					 LOCKDEP_NOW_UNRELIABLE);
+			pr_warn_once("TB-X505L: accepting Lenovo vendor module CRC drift; kernel tainted\n");
+			return 1;
+		}
 		pr_debug("Found checksum %lX vs module %lX\n",
 		       maybe_relocated(*crc, crc_owner), versions[i].crc);
 		goto bad_version;
